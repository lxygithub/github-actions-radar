    {
      "fullName": "libracoder/kiri",
      "owner": "libracoder",
      "name": "kiri",
      "url": "https://github.com/libracoder/kiri",
      "description": "A small, fast container runtime for macOS, Windows and Linux with free Ngrok alternative",
      "stars": 4210,
      "todayStars": null,
      "language": "Rust",
      "license": "Apache-2.0",
      "openIssues": 75,
      "sizeKb": 4082,
      "createdAt": "2026-11-02T16:11:30Z",
      "pushedAt": "2026-11-14T23:07:41Z",
      "topics": [
        "containers",
